# ── Database (docker-compose builds DATABASE_URL from these) ──
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragdb
# Used when running scripts on the host (inside Docker, compose overrides it)
DATABASE_URL=postgresql://raguser:change-me@localhost:5432/ragdb

# ── API auth ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_TO_A_RANDOM_KEY

# ── LLM providers ──
# Generation and the eval judge rotate across every GROQ_API_KEY* that is set
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Scope classifier and query transformation
GEMINI_API_KEY=

# Seconds to wait for the scope classifier, and retries after a failure.
# If Gemini is down or slow (e.g. 503 "high demand"), queries are let
# through as in-scope instead of failing the request. Gemini answers in
# 0.5-2 s when healthy but was measured at 3-12 s with 503s under load,
# so a short timeout and no retries bound its cost. trace_report shows
# how often the classifier fell back.
CLASSIFIER_TIMEOUT=2
CLASSIFIER_RETRIES=0

# Keyword stage: questions matching enough document terms skip the LLM classifier.
# Measure changes with: python -m scripts.scope_eval --dataset experiments/eval_dataset.json
KEYWORD_SCOPE_ENABLED=true
KEYWORD_SCOPE_BODY_TERMS=10
KEYWORD_SCOPE_MIN_MATCHES=2

# LLM scope check for questions the keyword stage is unsure about. Off: the gate and
# generator refused every off-topic probe Gemini caught (scope_probe, 2026-11-03).
# Re-run python -m scripts.scope_probe after changing RERANK_MIN_SCORE, the floor or documents.
SCOPE_LLM_ENABLED=false

# Query rewriting for /api/chat "strategy": multi, hyde or expand (default none). One extra
# LLM call per request; on error or timeout retrieval falls back to the plain query.
# Measure: python -m scripts.retrieval_eval --dataset experiments/eval_dataset.json --configs full,multi,hyde,expand --limit 50 --seed 7 --delay 4
QUERY_REWRITE_MODEL=gemini/gemini-3.1-flash-lite
QUERY_REWRITE_TIMEOUT=5
QUERY_REWRITE_RETRIES=0

# BM25 weight in hybrid fusion (dense weight is 1.0). Lower trusts embeddings more.
# Measure with: python -m scripts.retrieval_eval --dataset ... --sparse-weight 0.3
HYBRID_SPARSE_WEIGHT=1.0

# Reranker cost: candidates scored per question (0 = 4 x top_k) and tokens per
# query+passage pair (0 = model default, 512). 16 / 256 halves rerank time with the
# same quality on this corpus (see claude/measured-results.md). Large corpora with
# many relevant documents per query: use 40 / 256.
RERANK_CANDIDATES=16
RERANK_MAX_LENGTH=256

# Per-chunk floor: drop retrieved chunks scoring below RERANK_CHUNK_FLOOR or more than
# RERANK_CHUNK_MARGIN below the best one (empty = off). Choose with the floor simulation
# printed by scripts/retrieval_eval.py.
RERANK_CHUNK_FLOOR=-8
RERANK_CHUNK_MARGIN=

# Eval judge model (separate Groq quota from generation)
JUDGE_MODEL=groq/openai/gpt-oss-20b

# ── Local models (no key needed) ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Confidence gate: abstain without an LLM call below this rerank score ──
# Calibrate with: python -m scripts.calibrate --dataset experiments/eval_dataset.json
# Set to "off" to disable.
RERANK_MIN_SCORE=-6.0

# ── Source scoping ──
SCOPING_ENABLED=true
DOMAINS_CONFIG=config/domains.json
DOMAIN_PENALTY=2.0
DOMAIN_MIN_MARGIN=0.05

# ── Deduplication at ingest ──
DEDUP_ENABLED=true
DEDUP_COSINE=0.95
DEDUP_JACCARD=0.85

# ── Caching ──
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=512

# ── Observability ──
TRACE_BUFFER_SIZE=500
TRACE_LOG_PATH=experiments/traces.jsonl
# Per-request Python heap peak (adds overhead)
TRACE_TRACEMALLOC=false