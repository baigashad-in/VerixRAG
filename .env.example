# Database
DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb

# LLM Provider (one or both)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Seconds to wait for the scope classifier, and retries after a failure.
# If Gemini is down or slow (e.g. 503 "high demand"), queries are let
# through as in-scope instead of failing the request.
CLASSIFIER_TIMEOUT=5
CLASSIFIER_RETRIES=1

# Embedding model (local, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Reranker model (local, no key needed)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_TO_A_RANDOM_KEY