# ── Database (docker-compose builds DATABASE_URL from these) ──
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragdb
# Used when running scripts on the host (inside Docker, compose overrides it)
DATABASE_URL=postgresql://raguser:change-me@localhost:5432/ragdb

# ── API auth ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_TO_A_RANDOM_KEY

# ── LLM providers ──
# Generation and the eval judge rotate across every GROQ_API_KEY* that is set
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Scope classifier and query transformation
GEMINI_API_KEY=
# Seconds to wait for the scope classifier, and retries after a failure.
# If Gemini is down or slow (e.g. 503 "high demand"), queries are let
# through as in-scope instead of failing the request.
CLASSIFIER_TIMEOUT=5
CLASSIFIER_RETRIES=1

# Keyword stage: questions matching enough document terms skip the LLM classifier.
# Measure changes with: python -m scripts.scope_eval --dataset experiments/eval_dataset.json
KEYWORD_SCOPE_ENABLED=true
KEYWORD_SCOPE_BODY_TERMS=10
KEYWORD_SCOPE_MIN_MATCHES=2

# BM25 weight in hybrid fusion (dense weight is 1.0). Lower trusts embeddings more.
# Measure with: python -m scripts.retrieval_eval --dataset ... --sparse-weight 0.3
HYBRID_SPARSE_WEIGHT=1.0

# Eval judge model (separate Groq quota from generation)
JUDGE_MODEL=groq/openai/gpt-oss-20b

# ── Local models (no key needed) ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Confidence gate: abstain without an LLM call below this rerank score ──
# Calibrate with: python -m scripts.calibrate --dataset experiments/eval_dataset.json
# Set to "off" to disable.
RERANK_MIN_SCORE=-6.0

# ── Source scoping ──
SCOPING_ENABLED=true
DOMAINS_CONFIG=config/domains.json
DOMAIN_PENALTY=2.0
DOMAIN_MIN_MARGIN=0.05

# ── Deduplication at ingest ──
DEDUP_ENABLED=true
DEDUP_COSINE=0.95
DEDUP_JACCARD=0.85

# ── Caching ──
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=512

# ── Observability ──
TRACE_BUFFER_SIZE=500
TRACE_LOG_PATH=experiments/traces.jsonl
# Per-request Python heap peak (adds overhead)
TRACE_TRACEMALLOC=false